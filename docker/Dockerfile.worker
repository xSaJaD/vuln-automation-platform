# حاوية الـ worker — فيها أدوات ProjectDiscovery + Celery.

# ── مرحلة بناء الأدوات ──
FROM golang:1.26-bookworm AS tools
RUN apt-get update && apt-get install -y --no-install-recommends libpcap-dev \
    && rm -rf /var/lib/apt/lists/*
RUN go install -v github.com/projectdiscovery/subfinder/v2/cmd/subfinder@latest \
    && go install -v github.com/projectdiscovery/httpx/cmd/httpx@latest \
    && go install -v github.com/projectdiscovery/dnsx/cmd/dnsx@latest \
    && go install -v github.com/projectdiscovery/naabu/v2/cmd/naabu@latest \
    && go install -v github.com/projectdiscovery/katana/cmd/katana@latest \
    && go install -v github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest

# ── صورة التشغيل ──
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# naabu يحتاج libpcap وقت التشغيل
RUN apt-get update && apt-get install -y --no-install-recommends libpcap0.8 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# محرك Strix (يشغّل كل فحص في sandbox خاص — يحتاج وصولًا لـ Docker عند التشغيل).
RUN pip install --no-cache-dir strix-agent

# ننسخ أدوات ProjectDiscovery بعد pip حتى تفوز httpx مال PD على httpx مال بايثون
# (كلاهما /usr/local/bin/httpx — الترتيب مهم).
COPY --from=tools /go/bin/subfinder /go/bin/httpx /go/bin/dnsx /go/bin/naabu /go/bin/katana /go/bin/nuclei /usr/local/bin/

# نثبّت قوالب nuclei وقت البناء حتى تكون جاهزة دائمًا (لا تُفقد عند إعادة إنشاء
# الحاوية بـ docker compose down). يحتاج شبكة وقت البناء.
RUN nuclei -update-templates -silent || true

COPY api/ ./api/
COPY workers/ ./workers/

CMD ["celery", "-A", "workers.celery_app.celery_app", "worker", "--loglevel=info", "--concurrency=2"]
