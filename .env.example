# ──────────────────────────────────────────────────────────────
# انسخ هذا الملف إلى .env وعدّل القيم. لا تضع .env في git إطلاقًا.
# ──────────────────────────────────────────────────────────────

# ── Database ──
# يُستخدم من داخل الحاويات؛ host اسمه "postgres" من شبكة compose
DB_URL=postgresql+psycopg://strix:strix@postgres:5432/strix

POSTGRES_USER=strix
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=strix

# ── Redis / Celery broker ──
REDIS_URL=redis://redis:6379/0

# ── LLM (محرك Strix) ──
# مثال: anthropic/claude-sonnet-4-6 أو openai/gpt-... أو نموذج محلي عبر Ollama
STRIX_LLM=anthropic/claude-sonnet-4-6
LLM_API_KEY=
# حد أقصى لتكلفة LLM لكل تشغيل Strix (اختياري)، ومهلة التنفيذ بالثواني
STRIX_BUDGET=
STRIX_TIMEOUT=1800

# ── HackerOne API (اختياري — للمراحل المتقدمة فقط) ──
HACKERONE_API_USERNAME=
HACKERONE_API_TOKEN=

# ── الأمان ──
# مفتاح تشفير الحقول الحساسة (اعتمادات grey-box). ولّده بـ:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# حد الطلبات لكل IP في الدقيقة على الـ API
RATE_LIMIT_PER_MINUTE=300

# ── التنبيهات والمراقبة ──
# رابط webhook (Slack/Telegram/عام) لاستقبال التنبيهات — اتركه فارغًا للتعطيل
NOTIFY_WEBHOOK_URL=
# أدنى خطورة تُطلق تنبيهًا: info | low | medium | high | critical
NOTIFY_MIN_SEVERITY=high

# ── App ──
APP_ENV=development
LOG_LEVEL=info
API_PORT=8000
